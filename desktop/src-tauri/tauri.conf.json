{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChickReomte",
  "version": "1.0.20260920",
  "identifier": "org.mutantcat.chickreomte",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "小鸡远程 · ChickReomte", "width": 1040, "height": 760, "minWidth": 640, "minHeight": 580}],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'",
      "capabilities": [{"identifier": "main", "windows": ["main"], "permissions": ["core:default"]}]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "publisher": "Mutantcat",
    "category": "Utility",
    "shortDescription": "ChickReomte remote access client",
    "license": "MIT",
    "resources": {"../../LICENSE": "LICENSE", "../../third_party/rdesktop/LICENSE": "licenses/rdesktop-LICENSE"},
    "externalBin": ["binaries/chickreomte-cli"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {"minimumSystemVersion": "14.0", "signingIdentity": "-", "hardenedRuntime": false, "infoPlist": "Info.plist"},
    "windows": {"webviewInstallMode": {"type": "offlineInstaller"}, "nsis": {"installMode": "currentUser", "languages": ["English", "SimpChinese"], "displayLanguageSelector": true}},
    "linux": {"appimage": {"bundleMediaFramework": true, "files": {"usr/bin/xclip": "/usr/bin/xclip"}}}
  }
}
